{% layout none %}
<!DOCTYPE html>
<html lang="de" class="scroll-smooth">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Showroom Erleben | URBAN-PS GmbH - Medientechnik</title>
  
  <meta name="robots" content="noindex, nofollow">

  <script src="https://cdn.tailwindcss.com"></script>

  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            'ups-blue': { 500: '#3b82f6', 600: '#2563eb' },
            'ups-cyan': '#06b6d4',
            'ups-dark': '#020617', 
            'ups-surface': '#0f172a',
          }
        }
      }
    }
  </script>

  <style type="text/tailwindcss">
    @layer components {
      .glass-nav { @apply bg-ups-dark/80 backdrop-blur-xl border-b border-white/10 sticky top-0 z-[100]; }
      .btn-primary { @apply bg-ups-cyan text-ups-dark px-8 py-4 rounded-full font-extrabold tracking-tight hover:bg-white transition-all duration-300 shadow-[0_0_20px_rgba(6,182,212,0.4)]; }
      .card-glow { @apply bg-ups-surface border border-white/5 rounded-[2rem] p-8 transition-all hover:border-ups-blue-500/50 hover:shadow-[0_0_40px_rgba(37,99,235,0.15)]; }
      .footer-link { @apply hover:text-ups-cyan transition-colors duration-200; }
    }
  </style>

  {{ content_for_header }}
</head>
<body class="bg-ups-dark text-slate-200 font-sans antialiased">

  <nav class="glass-nav">
    <div class="max-w-7xl mx-auto px-6 h-24 flex items-center justify-between">
      <div class="flex flex-col">
        <span class="text-2xl font-extrabold tracking-tighter text-white uppercase">URBAN-PS <span class="text-ups-blue-500">GmbH</span></span>
        <span class="text-[10px] uppercase tracking-[0.2em] text-ups-cyan font-bold">Innovation Center</span>
      </div>
      <a href="#booking" class="btn-primary hidden md:block">Besuch anfragen</a>
    </div>
  </nav>

  <main>
    <section class="py-32 text-center">
      <h1 class="text-6xl font-extrabold text-white">Showroom Erleben.</h1>
      </section>
  </main>

  <footer class="py-20 bg-ups-dark text-slate-500 text-sm border-t border-white/5">
    <div class="max-w-7xl mx-auto px-6 grid md:grid-cols-2 gap-12 items-start">
      <div>
        <p class="font-bold text-white mb-4 text-lg tracking-tight">URBAN-PS GmbH</p>
        <div class="space-y-1 not-italic">
          <p>Hertzstraße 71</p>
          <p>13158 Berlin</p>
          <p class="pt-4 text-slate-400">Geschäftsführer: Frank Stampa</p>
        </div>
      </div>
      <div class="md:text-right flex flex-col md:items-end justify-between h-full">
        <div class="flex flex-wrap md:justify-end gap-x-6 gap-y-2 uppercase tracking-[0.15em] text-[10px] font-bold text-slate-400">
          <a href="https://urban-ps.de/policies/terms-of-service" class="footer-link">AGB</a>
          <a href="https://urban-ps.de/policies/legal-notice" class="footer-link">Impressum</a>
          <a href="https://urban-ps.de/policies/privacy-policy" class="footer-link">Datenschutz</a>
          <a href="/policies/refund-policy" class="footer-link">Widerruf</a>
        </div>
        <p class="mt-8 md:mt-0 opacity-50 italic">© {{ 'now' | date: "%Y" }} URBAN-PS GmbH. Alle Rechte vorbehalten.</p>
      </div>
    </div>
  </footer>

  {% comment %}
    In einem layout none template ist content_for_footer essentiell für Apps.
    Sollte "undefined" sichtbar sein, prüfen Sie installierte Apps auf Skripte, 
    die ein Standard-Layout erwarten.
  {% endcomment %}
  <div class="hidden">
    {{ content_for_footer }}
  </div>
</body>
</html>