{% layout none %}
<!DOCTYPE html>
<html lang="de" class="scroll-smooth">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Showroom Erleben | urban-ps.de - Medientechnik & Digital Signage</title>
  
  <meta name="robots" content="noindex, nofollow">

  <script src="https://cdn.tailwindcss.com"></script>

  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            // Die definierten Farbwerte für urban-ps / Showroom
            'ups-blue': {
              50: '#eff6ff',
              100: '#dbeafe',
              400: '#60a5fa',
              500: '#3b82f6', // Markenblau
              600: '#2563eb',
              900: '#1e3a8a',
            },
            'ups-cyan': '#06b6d4',
            'ups-dark': '#020617', // Deep Dark Slate für Premium-Look
            'ups-surface': '#0f172a',
          },
          fontFamily: {
            sans: ['Inter', 'system-ui', 'sans-serif'],
          },
          animation: {
            'pulse-slow': 'pulse 6s cubic-bezier(0.4, 0, 0.6, 1) infinite',
          }
        }
      }
    }
  </script>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;700;800&display=swap" rel="stylesheet">

  <style type="text/tailwindcss">
    @layer components {
      .glass-nav {
        @apply bg-ups-dark/80 backdrop-blur-xl border-b border-white/10 sticky top-0 z-[100];
      }
      .btn-primary {
        @apply bg-ups-cyan text-ups-dark px-8 py-4 rounded-full font-extrabold tracking-tight 
               hover:bg-white hover:scale-105 transition-all duration-300 
               shadow-[0_0_20px_rgba(6,182,212,0.4)];
      }
      .card-glow {
        @apply bg-ups-surface border border-white/5 rounded-[2rem] p-8 transition-all duration-500 
               hover:border-ups-blue-500/50 hover:shadow-[0_0_40px_rgba(37,99,235,0.15)];
      }
    }
  </style>

  {{ content_for_header }}
</head>
<body class="bg-ups-dark text-slate-200 font-sans antialiased selection:bg-ups-cyan selection:text-ups-dark">

  <nav class="glass-nav">
    <div class="max-w-7xl mx-auto px-6 h-24 flex items-center justify-between">
      <div class="flex flex-col">
        <span class="text-2xl font-extrabold tracking-tighter text-white">URBAN <span class="text-ups-blue-500">PS</span></span>
        <span class="text-[10px] uppercase tracking-[0.2em] text-ups-cyan font-bold">Showroom Lübeck</span>
      </div>
      <div class="hidden md:flex items-center gap-8 text-sm font-bold tracking-widest uppercase">
        <a href="#technologien" class="hover:text-ups-cyan transition">Hardware</a>
        <a href="#erlebnis" class="hover:text-ups-cyan transition">Der Showroom</a>
        <a href="#booking" class="btn-primary">Besuch planen</a>
      </div>
    </div>
  </nav>

  <header class="relative min-h-[85vh] flex items-center justify-center pt-20">
    <div class="absolute top-0 left-1/4 w-[500px] h-[500px] bg-ups-blue-600/20 rounded-full blur-[120px] animate-pulse-slow"></div>
    <div class="absolute bottom-0 right-1/4 w-[600px] h-[600px] bg-ups-cyan/10 rounded-full blur-[150px]"></div>

    <div class="relative z-10 max-w-6xl mx-auto px-6 text-center">
      <h1 class="text-5xl md:text-8xl font-extrabold tracking-tighter text-white mb-8 leading-[0.9]">
        Technik spüren,<br>bevor sie <span class="text-transparent bg-clip-text bg-gradient-to-r from-ups-blue-400 to-ups-cyan">installiert wird.</span>
      </h1>
      <p class="text-xl md:text-2xl text-slate-400 max-w-3xl mx-auto mb-12 leading-relaxed">
        Validieren Sie LED-Systeme, interaktive Kioske und Konferenztechnik live in unserem Lübecker Experience Center. 
        <span class="text-white">Keine Kataloge. Nur Realität.</span>
      </p>
      <div class="flex flex-col md:flex-row items-center justify-center gap-6">
        <a href="#booking" class="btn-primary w-full md:w-auto text-center">Individuelle Demo buchen</a>
        <a href="#technologien" class="text-white font-bold border-b-2 border-ups-blue-500 pb-1 hover:text-ups-cyan hover:border-ups-cyan transition">Highlights ansehen</a>
      </div>
    </div>
  </header>

  <section id="technologien" class="py-32 relative">
    <div class="max-w-7xl mx-auto px-6">
      <div class="mb-20 text-center">
        <h2 class="text-4xl md:text-6xl font-extrabold tracking-tighter text-white mb-4">Das Inventar der Möglichkeiten.</h2>
        <p class="text-slate-500 text-lg">Wählen Sie Ihren Fokusbereich für die Live-Präsentation.</p>
      </div>

      <div class="grid md:grid-cols-3 gap-8">
        <div class="card-glow group">
          <div class="h-48 rounded-2xl bg-slate-800 mb-8 overflow-hidden relative">
            <img src="https://images.unsplash.com/photo-1540575861501-7cf05a4b125a?auto=format&fit=crop&q=80&w=800" class="w-full h-full object-cover group-hover:scale-110 transition duration-700 opacity-60">
            <div class="absolute inset-0 bg-ups-blue-900/40 mix-blend-overlay"></div>
          </div>
          <h3 class="text-2xl font-bold text-white mb-4 italic">High-Pitch LED Walls</h3>
          <ul class="space-y-3 text-slate-400 text-sm">
            <li class="flex items-center gap-2"><span class="text-ups-cyan">✔</span> 138" All-in-One Systeme</li>
            <li class="flex items-center gap-2"><span class="text-ups-cyan">✔</span> Custom Pixel-Pitch Tests</li>
            <li class="flex items-center gap-2"><span class="text-ups-cyan">✔</span> Helligkeits-Validierung</li>
          </ul>
        </div>

        <div class="card-glow group">
          <div class="h-48 rounded-2xl bg-slate-800 mb-8 overflow-hidden relative">
            <img src="https://images.unsplash.com/photo-1431540015161-0bf868a2d407?auto=format&fit=crop&q=80&w=800" class="w-full h-full object-cover group-hover:scale-110 transition duration-700 opacity-60">
            <div class="absolute inset-0 bg-ups-blue-900/40 mix-blend-overlay"></div>
          </div>
          <h3 class="text-2xl font-bold text-white mb-4 italic">Modern Workplace</h3>
          <ul class="space-y-3 text-slate-400 text-sm">
            <li class="flex items-center gap-2"><span class="text-ups-cyan">✔</span> Teams / Zoom Room Setups</li>
            <li class="flex items-center gap-2"><span class="text-ups-cyan">✔</span> Drahtlose Präsentation (BYOD)</li>
            <li class="flex items-center gap-2"><span class="text-ups-cyan">✔</span> Akustik & Kamera-Tracking</li>
          </ul>
        </div>

        <div class="card-glow group">
          <div class="h-48 rounded-2xl bg-slate-800 mb-8 overflow-hidden relative">
            <img src="https://images.unsplash.com/photo-1517245386807-bb43f82c33c4?auto=format&fit=crop&q=80&w=800" class="w-full h-full object-cover group-hover:scale-110 transition duration-700 opacity-60">
            <div class="absolute inset-0 bg-ups-blue-900/40 mix-blend-overlay"></div>
          </div>
          <h3 class="text-2xl font-bold text-white mb-4 italic">Interactive Kiosk</h3>
          <ul class="space-y-3 text-slate-400 text-sm">
            <li class="flex items-center gap-2"><span class="text-ups-cyan">✔</span> Outdoor Stehlen-Test</li>
            <li class="flex items-center gap-2"><span class="text-ups-cyan">✔</span> Touch-CMS Evaluation</li>
            <li class="flex items-center gap-2"><span class="text-ups-cyan">✔</span> Wegeleit-Szenarien</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section id="booking" class="py-32 bg-white text-ups-dark rounded-[4rem]">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <h2 class="text-5xl md:text-7xl font-extrabold tracking-tighter mb-8">Bereit für den Reality-Check?</h2>
      <p class="text-xl text-slate-600 mb-16">
        Wählen Sie einen Termin. Frank Stampa und das Team bereiten die Technik exakt für Ihre Anforderungen vor.
      </p>
      
      <div class="bg-slate-100 p-12 rounded-[3rem] border-4 border-dashed border-slate-300 relative">
        <div class="flex flex-col items-center">
          <div class="w-20 h-20 bg-ups-blue-600 rounded-full flex items-center justify-center text-white text-3xl mb-6 shadow-xl">
            📅
          </div>
          <p class="font-bold text-2xl mb-2">Ihr persönliches Demo-Zeitfenster</p>
          <p class="text-slate-500 mb-8 italic">Hier wird Ihr Shopify-Buchungs-App Widget (z.B. Sesami) injiziert.</p>
          <button class="bg-ups-dark text-white px-12 py-5 rounded-full font-bold hover:bg-ups-blue-600 transition shadow-2xl">
            KALENDER LADEN
          </button>
        </div>
      </div>
    </div>
  </section>

  <footer class="py-16 text-center text-slate-600 text-xs tracking-widest uppercase">
    <div class="max-w-7xl mx-auto px-6">
      <p class="mb-4">&copy; {{ 'now' | date: "%Y" }} urban-ps.de | Frank Stampa Medientechnik</p>
      <div class="flex justify-center gap-6">
        <a href="/policies/impressum" class="hover:text-ups-cyan">Impressum</a>
        <a href="/policies/datenschutz" class="hover:text-ups-cyan">Datenschutz</a>
      </div>
    </div>
  </footer>

  {{ content_for_footer }}
</body>
</html>