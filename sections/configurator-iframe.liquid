{% comment %}
  Configurator iframe section
  Embeds the ConfiguratorWare iframe and listens for add-to-cart postMessage
{% endcomment %}

{%- liquid
  assign config_url = section.settings.configurator_url | default: 'https://urban-ps.app.configuratorware.de/identifier:meetingraum?_language=de_DE&_hide_prices=1'
-%}

<div class="configurator-iframe-section page-width">
  <div class="configurator-iframe-wrapper" style="min-height: {{ section.settings.min_height }}px;">
    <iframe
      src="{{ config_url }}"
      title="{{ section.settings.iframe_title | default: 'Konfigurator' }}"
      class="configurator-iframe"
      style="width: 100%; height: {{ section.settings.iframe_height }}px; border: 0;"
      loading="lazy"></iframe>
  </div>
</div>

<script>
(function() {
  window.addEventListener('message', function(event) {
    var data = event.data;
    if (!data || typeof data !== 'object') return;

    var method = data.method;
    var articlenumber = data.articlenumber;

    switch (method) {
      case 'addtocart':
        if (articlenumber) {
          addConfiguratorToCart(articlenumber);
        }
        break;
      default:
        break;
    }
  });

  function addConfiguratorToCart(articlenumber) {
    var variantId = null;
    if (/^\d+$/.test(String(articlenumber))) {
      variantId = parseInt(articlenumber, 10);
    }
    if (variantId) {
      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({ id: variantId, quantity: 1 })
      }).then(function(res) {
        if (res.ok) {
          document.dispatchEvent(new CustomEvent('cart:refresh'));
          if (window.refreshCart) window.refreshCart();
        }
      }).catch(function(err) { console.warn('[configurator] Add to cart failed:', err); });
      return;
    }
    fetch('/search/suggest.json?q=' + encodeURIComponent(articlenumber) + '&resources[type]=product&resources[limit]=5')
      .then(function(r) { return r.json(); })
      .then(function(json) {
        var products = json.resources && json.resources.results && json.resources.results.products;
        if (!products || products.length === 0) {
          console.warn('[configurator] No product found for articlenumber:', articlenumber);
          return;
        }
        var product = products[0];
        var vid = product.variants && product.variants[0] && product.variants[0].id;
        if (!vid) return;
        return fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body: JSON.stringify({ id: vid, quantity: 1 })
        });
      })
      .then(function(res) {
        if (res && res.ok) {
          document.dispatchEvent(new CustomEvent('cart:refresh'));
          if (window.refreshCart) window.refreshCart();
        }
      })
      .catch(function(err) { console.warn('[configurator] Add to cart failed:', err); });
  }
})();
</script>

{% schema %}
{
  "name": "Configurator iframe",
  "tag": "section",
  "class": "configurator-iframe-section",
  "settings": [
    {
      "type": "text",
      "id": "configurator_url",
      "label": "Configurator URL",
      "default": "https://urban-ps.app.configuratorware.de/identifier:meetingraum?_language=de_DE&_hide_prices=1",
      "info": "Staging: https://urban-ps.staging.configuratorware.de/identifier:meetingraum?_language=de_DE&_hide_prices=1"
    },
    {
      "type": "text",
      "id": "iframe_title",
      "label": "Iframe title",
      "default": "Konfigurator"
    },
    {
      "type": "range",
      "id": "iframe_height",
      "label": "Iframe height",
      "min": 400,
      "max": 1200,
      "step": 50,
      "unit": "px",
      "default": 800
    },
    {
      "type": "range",
      "id": "min_height",
      "label": "Minimum wrapper height",
      "min": 400,
      "max": 1200,
      "step": 50,
      "unit": "px",
      "default": 800
    }
  ],
  "presets": [
    {
      "name": "Configurator iframe"
    }
  ]
}
{% endschema %}
